# Reference only. Spring Boot does not automatically load .env files.
# Recommended: node scripts/init-local.mjs, then edit .local/<service>.json.
# Each business service receives its own SERVICE_TOKEN.
SERVER_ADDRESS=127.0.0.1
SERVICE_HOST=localhost
EUREKA_URL=http://REPLACE_USER:REPLACE_PASSWORD@localhost:8761/eureka/
EUREKA_USERNAME=REPLACE_WITH_REGISTRY_USERNAME
EUREKA_PASSWORD=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_X509_RSA_PUBLIC_KEY
# Identity only; do not distribute either value to other services.
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_PKCS8_RSA_PRIVATE_KEY
TOTP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
SERVICE_TOKEN=REPLACE_WITH_RANDOM_TOKEN_UNIQUE_TO_THIS_SERVICE
# SHA-256 hex hashes of caller tokens, never the other services' plaintext tokens.
IDENTITY_SERVICE_TOKEN_HASH=REPLACE_WITH_SHA256_HEX
ACCOUNTS_SERVICE_TOKEN_HASH=REPLACE_WITH_SHA256_HEX
PAYMENTS_SERVICE_TOKEN_HASH=REPLACE_WITH_SHA256_HEX
PRODUCTS_SERVICE_TOKEN_HASH=REPLACE_WITH_SHA256_HEX
NOTIFICATION_SERVICE_TOKEN_HASH=REPLACE_WITH_SHA256_HEX
AUDIT_SERVICE_TOKEN_HASH=REPLACE_WITH_SHA256_HEX
CORS_ORIGINS=http://localhost:8000
