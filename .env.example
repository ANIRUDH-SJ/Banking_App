# Non-secret configuration names for Docker or local environment tooling.
# Copy this file to .env and replace placeholders locally. Never commit .env.
DB_URL=jdbc:oracle:thin:@//127.0.0.1:1521/FREEPDB1
DOCKER_DB_URL=jdbc:oracle:thin:@//host.docker.internal:1521/FREEPDB1
DB_USERNAME=net_banking_app
DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
TOTP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
EUREKA_SERVER_PORT=8761
EUREKA_USERNAME=REPLACE_WITH_REGISTRY_USERNAME
EUREKA_PASSWORD=REPLACE_WITH_AT_LEAST_16_CHARACTERS
BACKEND_PORT=8080
SMTP_HOST=localhost
SMTP_PORT=1025
SMS_PROVIDER_URL=http://localhost:8089/mock-sms
FRONTEND_API_URL=http://localhost:8080/api/v1
