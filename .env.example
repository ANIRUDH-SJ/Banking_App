# Reference for Spring variables. For the multi-service .env used by Node startup,
# run scripts/export-local-env.mjs to preserve all per-service credentials.
# Prefix service variables, e.g. IDENTITY_SERVICE__DB_USERNAME=NB_IDENTITY.
# Spring Boot itself does not automatically load .env files.
# Recommended: node scripts/init-local.mjs, then edit .local/<service>.json.
# Each business service receives its own DB_USERNAME, DB_PASSWORD and SERVICE_TOKEN.
DB_URL=jdbc:oracle:thin:@//127.0.0.1:1521/FREEPDB1
DB_USERNAME=NB_IDENTITY
DB_PASSWORD=REPLACE_WITH_LOCAL_SCHEMA_PASSWORD
SERVER_ADDRESS=127.0.0.1
SERVICE_HOST=localhost
EUREKA_URL=http://REPLACE_USER:REPLACE_PASSWORD@localhost:8761/eureka/
EUREKA_USERNAME=REPLACE_WITH_REGISTRY_USERNAME
EUREKA_PASSWORD=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_X509_RSA_PUBLIC_KEY
# Identity only; do not distribute either value to other services.
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_PKCS8_RSA_PRIVATE_KEY
TOTP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
SERVICE_TOKEN=REPLACE_WITH_RANDOM_TOKEN_UNIQUE_TO_THIS_SERVICE
# SHA-256 hex hashes of caller tokens, never the other services' plaintext tokens.
IDENTITY_SERVICE_TOKEN_HASH=REPLACE_WITH_SHA256_HEX
ACCOUNTS_SERVICE_TOKEN_HASH=REPLACE_WITH_SHA256_HEX
PAYMENTS_SERVICE_TOKEN_HASH=REPLACE_WITH_SHA256_HEX
PRODUCTS_SERVICE_TOKEN_HASH=REPLACE_WITH_SHA256_HEX
NOTIFICATION_SERVICE_TOKEN_HASH=REPLACE_WITH_SHA256_HEX
AUDIT_SERVICE_TOKEN_HASH=REPLACE_WITH_SHA256_HEX
CORS_ORIGINS=http://localhost:8000
# Products service demo early-closure policy, in percentage points.
DEPOSIT_EARLY_CLOSURE_RATE_REDUCTION=1.00
# Notification service email delivery. Keep the log provider for local development.
NOTIFICATION_EMAIL_PROVIDER=log
# Required when NOTIFICATION_EMAIL_PROVIDER=smtp.
NOTIFICATION_EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
SMTP_SSL_ENABLE=false
SMTP_SSL_CHECK_SERVER_IDENTITY=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000
SMTP_TEST_CONNECTION=false
# Optional separate migration account, configured with access to the same service schema.
# MIGRATION_USERNAME=
# MIGRATION_PASSWORD=
