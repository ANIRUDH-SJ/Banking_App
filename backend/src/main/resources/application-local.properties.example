# Copy this file to application-local.properties and replace the password locally.
# application-local.properties is ignored by Git. Never commit a real password.
spring.datasource.url=jdbc:oracle:thin:@//127.0.0.1:1521/FREEPDB1
spring.datasource.username=net_banking_app
spring.datasource.password=REPLACE_WITH_YOUR_LOCAL_PASSWORD
spring.datasource.driver-class-name=oracle.jdbc.OracleDriver

# The schema is managed by the versioned SQL scripts in /database.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.format_sql=true
